# Local dev (docker compose up): use host-mapped ports below.
# Production (docker compose -f docker-compose.yml -f docker-compose.prod.yml):
#   DATABASE_URL host = postgres, REDIS_URL host = redis (see prod block in README).

ENVIRONMENT=local
DEBUG=true

# Docker Compose dev (postgres on host port 5433, redis on 6380)
DATABASE_URL=postgresql+asyncpg://ai_server:ai_server_pass@localhost:5433/ai_server_db
REDIS_URL=redis://localhost:6380

# Docker Compose prod (services on internal network — set these in server .env)
# DATABASE_URL=postgresql+asyncpg://ai_server:ai_server_pass@postgres:5432/ai_server_db
# REDIS_URL=redis://redis:6379
# ENVIRONMENT=production
# DEBUG=false

# Must match Ding-Platform-Backend JWT_SECRET for Bearer tokens from the platform
JWT_SECRET=change-me
SERVICE_API_KEY=change-me

# Docker Compose: use service name. Local API outside Docker: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MAX_CONTEXT_MESSAGES=20

# Embedded Kokoro TTS (loads at startup; set false to skip in lightweight dev)
TTS_ENABLED=true
TTS_LANG_CODE=a
TTS_SPEED=1.28

# Optional CORS (JSON array). Default in app is ["*"]
# ALLOWED_ORIGINS=["http://your-server-ip","https://your-domain"]
